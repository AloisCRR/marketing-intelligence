{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "CONTEXT.md"
    ],
    "mcp": {
        "prefect": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "prefect-mcp",
                "prefect-mcp-server"
            ],
            "environment": {
                "PREFECT_API_URL": "http://127.0.0.1:4200/api"
            },
            "enabled": true
        }
    }
}
