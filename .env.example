# Copy to .env for local development (never commit .env).
DATABASE_URL=postgresql://brain:brain@localhost:5433/brain
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
POSTGRES_DB=brain
POSTGRES_PORT=5433
# Static bearer token for the HTTP API + MCP streamable-HTTP app (Option 1).
# Generate with: openssl rand -hex 32. Inject as a Dokploy env var in deployed
# environments. When unset/blank, auth is disabled (local-dev open mode only).
BRAIN_API_TOKEN=
# Public base URL of the MCP service (Traefik domain in prod), used for OAuth
# resource metadata only (static bearer has no OAuth issuer). The MCP path is
# always /mcp (FastMCP streamable_http_path default).
BRAIN_PUBLIC_URL=http://localhost:8124
# Container/compose publish ports (host side). Containers always listen on
# 8123 (api) / 8124 (mcp) internally; Traefik routes to the container ports.
API_PORT=8123
MCP_PORT=8124
# NOTE: inside compose/Dokploy, DATABASE_URL must point at the compose host:
#   DATABASE_URL=postgresql://brain:brain@db:5432/brain
# (the default above is for host-side local dev against the published 5433).
# Prefect worker: localhost inside a container is the container itself, so the
# worker MUST use the compose service hostname (`db`, or `brain-db` / the
# Dokploy-managed Postgres internal hostname on Dokploy), never localhost.
#   DATABASE_URL=postgresql://brain:brain@db:5432/brain
# Local Prefect server (required by `make ingest`; see docs/prefect-local.md).
# Point at the local server started via `make prefect-up` / `prefect server start`.
# Env vars override the Prefect profile (~/.prefect/profiles.toml).
PREFECT_API_URL=http://127.0.0.1:4200/api
# Optional Prefect settings (worker + flows):
# PREFECT_WORK_POOL=default
